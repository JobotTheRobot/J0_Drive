	(text "SCREF used to define MOSFET short-circuit detection threshold.\nResistor divider sets SCREF to 1.03V\n(3.3V * (10 / (10+22)) = 1.03\nFilter capacitor shunts fast noise to ground (RC low-pass filter)"
		(exclude_from_sim no)
		(at 66.548 47.752 0)
		(effects
			(font
				(size 0.635 0.635)
			)
			(justify left top)
		)
		(uuid "99ba05e3-b355-4b64-9fcd-f6161cd4f0b1")
	)
	(text "DT/MODE"
		(exclude_from_sim no)
		(at 40.132 82.804 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "9fe5af27-5b4d-4399-a8b7-75a738512dff")
	)
	(text "Deadtime/mode:\n- Connected to GND through R_DT:\n	Inputs are ENx and INx, with deadtime calculated by\n		R_DT[kOhm] = 96.15 * DT[us] - 4.45\n		- ex: R_DT = 51k, DT = 570ns\n- Shorted to GND: \n	Inputs are INHx and INLx, deadtime programmed in firmware\n	- Still safe if both inputs are HIGH because of interlocking"
		(exclude_from_sim no)
		(at 40.132 84.836 0)
		(effects
			(font
				(size 0.635 0.635)
			)
			(justify left top)
		)
		(uuid "d8ea5b78-0ed6-451c-8142-c3206e365daa")
	)
