	)
	(text "SCREF used to define MOSFET short-circuit detection threshold.\nResistor divider sets SCREF to 1.03V\n(3.3V * (10 / (10+22)) = 1.03\nFilter capacitor shunts fast noise to ground (RC low-pass filter)"
		(exclude_from_sim no)
		(at 55.372 68.58 0)
		(effects
			(font
				(size 0.635 0.635)
			)
			(justify left top)
